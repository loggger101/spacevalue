# The priced tables and the quote snapshots are CRLF BY CONTRACT, not by
# accident of platform: the writer pins lineterminator="\r\n", every sha256 a
# release manifest or SHA256SUMS records is a hash of those bytes, and the
# tables economicspace measured against were written that way.  -text keeps git
# from normalising them on a Linux checkout.
*.csv -text

# Everything else is ordinary source: LF.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
spacevalue/quotes/SHA256SUMS text eol=lf

# samebytes' stat-cache hook (.githooks/) MUST be LF: a CRLF `#!/bin/sh` fails
# as "bad interpreter", silently, after every checkout.
.githooks/*  text eol=lf
